# .htaccess pour GRADIENT - Optimisations SEO et Performance

# Activer la réécriture d'URL
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcer HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Forcer www ou non-www (choisir l'un ou l'autre)
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

  # Redirection trailing slash
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]
</IfModule>

# Compression GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On

  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS et JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Polices
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # HTML
  ExpiresByType text/html "access plus 0 seconds"

  # Manifest
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# En-têtes de sécurité
<IfModule mod_headers.c>
  # HSTS (strict transport security)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Protection XSS
  Header set X-XSS-Protection "1; mode=block"

  # Empêcher le MIME sniffing
  Header set X-Content-Type-Options "nosniff"

  # Contrôle du referrer
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Cache-Control pour HTML
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache-Control pour assets
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Protection des fichiers sensibles
<FilesMatch "^(\.htaccess|\.git|\.env|package\.json|package-lock\.json|tsconfig\.json)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Page d'erreur personnalisée
ErrorDocument 404 /index.html

# Type MIME
AddType application/javascript .js
AddType text/css .css
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest
